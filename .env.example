# Docker / Linux NAS (compose). On Windows local dev, if you keep this path, Next.js uses
# `file:./dev.db` automatically — run `npm run db:push` so Prisma updates that same file.
DATABASE_URL="file:/app/data/gamelib.db"
LIBRARY_ROOT="/library/games"
ART_CACHE_DIR="/app/data/artwork"
PORT="3000"
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
RAWG_API_KEY=""

# Disable automatic daily scan in production (Next.js server). Default: enabled in production only.
# SCAN_CRON_DISABLED=1

# docker-compose.yml (image from GHCR — see .github/workflows/docker.yml)
# GAMELIB_IMAGE=ghcr.io/YOUR_GITHUB_USER_OR_ORG/gamelib:latest
# LIBRARY_HOST_PATH=/path/on/host/to/games

# Windows local dev example:
# DATABASE_URL="file:./dev.db"
# Windows: prefer a real folder (Z:\Games). Mapped Z: may be invisible to Node if the dev
# server was started as another user / admin — use UNC instead: \\NAS\share\games
# LIBRARY_ROOT="Z:\\Games"
