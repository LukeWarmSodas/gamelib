DATABASE_URL="file:/app/data/gamelib.db"
LIBRARY_ROOT="/library/games"
ART_CACHE_DIR="/app/data/artwork"
PORT="3000"
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# docker-compose.yml (image from GHCR — see .github/workflows/docker.yml)
# GAMELIB_IMAGE=ghcr.io/YOUR_GITHUB_USER_OR_ORG/gamelib:latest
# LIBRARY_HOST_PATH=/path/on/host/to/games

# Windows local dev example:
# DATABASE_URL="file:./dev.db"
# LIBRARY_ROOT="Z:\\Games"
